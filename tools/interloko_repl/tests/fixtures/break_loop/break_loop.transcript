  frame:1 shade(s: <sphere>, distance: 1.5)          method:m0@1    repl.loko:37
  frame:2 pixel(s: <sphere>, x: 1.5)                 function:f1@1  repl.loko:44
  frame:3 render(s: <sphere>, film: <film>)          function:f2@1  repl.loko:53
  frame:4 main()                                     function:f3@1  repl.loko:60
restarts:
  restart:0 use-value(value :: <double-float>)  the signal in frame:0 returns value
  restart:1 skip-pixel()                 the handle in frame:2 (repl.loko:45) returns 0.0
  restart:2 retry(frame :: <frame>)      call a frame's function again, with current definitions
  restart:3 abort()                      unwind to top level, running cleanups
choose with :restart <n|name> [args...] or :invoke condition:0 choose-restart

