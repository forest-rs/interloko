// Step 4: redefine the faulty method in place. The first attempt is
// rejected; the corrected one is soft-typed and installed as a new code
// unit while frame:1 keeps the old one.
> :edit method:m0
editing form:f6 method shade (method:m0); enter a replacement definition, or :cancel
  34 | define method shade(s :: <sphere>, distance :: <double-float>) => <double-float>
  35 |   // Brightness falls off linearly with distance from the sphere's axis.
  36 |   // Bug: a ray that misses the sphere gets a negative brightness.
  37 |   check-sample(1.0 - distance / s.radius, distance)
  38 | end;
> define method shade(s :: <sphere>, distance :: <double-float>) => <double-float>
>   // A ray that misses the sphere is black, not negatively bright.
>   check-sample(max(0, 1.0 - distance / s.radius), distance)
> end;
! diagnostics:
!   Error sem.function-argument-type-mismatch 1142..1143 function `max` argument 1 expects <float> but got <integer>
! edit rejected: form:f6 and method:m0@1 are unchanged; still editing form:f6
> define method shade(s :: <sphere>, distance :: <double-float>) => <double-float>
>   // A ray that misses the sphere is black, not negatively bright.
>   check-sample(max(0.0, 1.0 - distance / s.radius), distance)
> end;
