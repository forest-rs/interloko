// The kernel library: the parts of Loko's kernel written in Loko.
//
// Each definition here joins a program only when the program needs it:
// a function when a call or a value names it (one the `library` module
// exports, or one another library definition calls), and a method of a
// collection generic when the program uses the generic. Its code is the
// kernel's, so it sees no definition of the program: `size` here is always
// the kernel's `size`, whatever the program defines.
//
// Code here keeps to what typing proves or checks cheaply, since every
// program that uses it pays for it.

// --- Lists as sequences --------------------------------------------------

// A list's size is its number of pairs, up to the first tail that is not a
// pair.
define method size (c :: <list>) => <integer>
  let n = 0;
  let rest :: <object> = c;
  while (instance?(rest, <pair>))
    n := n + 1;
    rest := tail(rest)
  end;
  n
end;

// The pair a list's index `key` names, or `#f` past its end.
define function list-pair (c :: <list>, key :: <integer>) => <object>
  let rest :: <object> = c;
  let i = key;
  while (i > 0 & instance?(rest, <pair>))
    i := i - 1;
    rest := tail(rest)
  end;
  if (key >= 0 & instance?(rest, <pair>)) rest else #f end
end;

define method element (c :: <list>, key :: <integer>, #key default) => <object>
  let found = list-pair(c, key);
  if (instance?(found, <pair>))
    head(found)
  elseif (default == $unsupplied)
    error("element: %= has no element %=", c, key)
  else
    default
  end
end;

define method element-setter (value :: <object>, c :: <list>, key :: <integer>) => <object>
  let found = list-pair(c, key);
  if (instance?(found, <pair>))
    head-setter(value, found)
  else
    error("element-setter: %= has no element %=", c, key)
  end
end;

// A list's states are its pairs, from the list itself to its last pair:
// each step is a `tail`, and its element is the pair's `head`.
define method forward-iteration-protocol (c :: <list>)
 => (<object>, <object>, callable(<object>, <object>) => <object>,
     callable(<object>, <object>, <object>) => <boolean>,
     callable(<object>, <object>) => <object>,
     callable(<object>, <object>) => <object>, <object>)
  values(c, #f,
         method (c :: <object>, s :: <object>) => <object> tail(s) end,
         method (c :: <object>, s :: <object>, l :: <object>) => <boolean>
           ~instance?(s, <pair>)
         end,
         // The key of a pair is its index, counted from the start.
         method (c :: <object>, s :: <object>) => <object>
           let i = 0;
           let rest :: <object> = c;
           while (rest ~== s)
             i := i + 1;
             rest := tail(rest)
           end;
           i
         end,
         method (c :: <object>, s :: <object>) => <object> head(s) end,
         method (v :: <object>, c :: <object>, s :: <object>) => <object>
           head-setter(v, s)
         end)
end;

// --- Sequence functions --------------------------------------------------
//
// Dylan's collection functions over any collection, through the iteration
// protocol. One that makes a collection makes one of its argument's kind,
// as Dylan's `type-for-copy` has it: a list from a list, a string from a
// string, a stretchy vector from a stretchy vector, and a vector from any
// other.

// Whether `c` has no elements.
define function empty? (c) => <boolean>
  if (instance?(c, <list>)) c == #() else size(c) = 0 end
end;

// Whether `c` has an element `==` to `value`, as Dylan's default test has
// it.
define function member? (value, c) => <boolean>
  block (return)
    for (x in c)
      if (x == value) return(#t) end
    end;
    #f
  end
end;

// `f` applied to `initial` and the first element, then to that result and
// the next, and so on: `initial` for no elements.
define function reduce (f :: <function>, initial, c) => <object>
  let result :: <object> = initial;
  for (x in c) result := f(result, x) end;
  result
end;

// The element `n` from the start: a string's keys are positions.
define function nth (c, n :: <integer>) => <object>
  if (instance?(c, <string>))
    let text = as(<string>, c);
    text[position-at(text, n)]
  else
    c[n]
  end
end;

define function first (c) => <object> nth(c, 0) end;
define function second (c) => <object> nth(c, 1) end;
define function third (c) => <object> nth(c, 2) end;

// A new collection of `c`'s kind holding `elements`, in order.
define function copy-like (c, elements :: <list>) => <object>
  if (instance?(c, <list>))
    elements
  elseif (instance?(c, <string>))
    let text = make(<string-builder>);
    for (x in elements) add!(text, as(<character>, x)) end;
    as(<string>, text)
  elseif (instance?(c, <stretchy-vector>))
    let v = make(<stretchy-vector>);
    for (x in elements) add!(v, x) end;
    v
  else
    let v = make(<vector>, size: size(elements));
    for (x in elements, i from 0) v[i] := x end;
    v
  end
end;

// `list` as a value: a call of the name makes its pairs inline, and a call
// through the value collects the arguments first.
define function list (#rest elements) => <list>
  let result :: <list> = #();
  for (i from size(elements) - 1 to 0 by -1) result := pair(elements[i], result) end;
  result
end;

// The elements of `c` in reverse order, as a new list.
define function reversed-elements (c) => <list>
  let result :: <list> = #();
  for (x in c) result := pair(x, result) end;
  result
end;

// `l` reversed in place: each pair's tail turned to point at the one
// before it.
define function reverse-list! (l :: <list>) => <list>
  let result :: <list> = #();
  let rest :: <object> = l;
  while (instance?(rest, <pair>))
    let following = tail(rest);
    tail-setter(result, rest);
    result := rest;
    rest := following
  end;
  result
end;

// A new collection of `c`'s kind with its elements in reverse order.
define function reverse (c) => <object>
  copy-like(c, reversed-elements(c))
end;

// `c` with its elements in reverse order, reusing a list's pairs; any
// other collection is copied, as `reverse` does.
define function reverse! (c) => <object>
  if (instance?(c, <list>)) reverse-list!(c) else reverse(c) end
end;

// A new collection of `c`'s kind holding `f` of each of its elements.
define function map (f :: <function>, c) => <object>
  let results :: <list> = #();
  for (x in c)
    let result :: <object> = f(x);
    results := pair(result, results)
  end;
  copy-like(c, reverse-list!(results))
end;

// `concatenate(a, b)`: a new collection of `a`'s kind holding the
// elements of `a`, then those of `b`. A character stands for the string
// of it, as the kernel's string `concatenate` takes one.
define function concatenate-two (a, b) => <object>
  let first-part :: <object> = if (instance?(a, <character>)) as(<string>, a) else a end;
  let elements :: <list> = reversed-elements(first-part);
  if (instance?(b, <character>))
    elements := pair(b, elements)
  else
    for (x in b) elements := pair(x, elements) end
  end;
  copy-like(first-part, reverse-list!(elements))
end;
