grammar calculator
rule calculator-region = calculator-function+
rule calculator-function @role=definition = name `=` expression => emit-function(name: name, body: expression)
rule expression = term additive-tail* => fold-binary(lhs: term, tails: additive-tail*)
rule additive-tail = add-op term => emit-binary-tail(op: add-op, rhs: term)
rule add-op = `+` | `-`
rule term = factor multiplicative-tail* => fold-binary(lhs: factor, tails: multiplicative-tail*)
rule multiplicative-tail = mul-op factor => emit-binary-tail(op: mul-op, rhs: factor)
rule mul-op = `*` | `/`
rule factor = negative | parenthesized | call | float-literal | number-literal | name-ref
rule negative = `-` factor => emit-negate(value: factor)
rule parenthesized = `(` expression `)`
rule float-literal = float => emit-float(value: float)
rule number-literal = number => emit-integer(value: number)
rule name-ref = name => emit-name(name: name)
rule call = name `(` argument-list? `)` => emit-call(callee: name, args: argument-list*)
rule argument-list @list=call-arguments = expression argument-tail* => emit-argument-list(first: expression, rest: argument-tail*)
rule argument-tail = `,` expression => emit-argument-tail(value: expression)
rule name = [A-Za-z_] [A-Za-z0-9_?-]*
rule float raw = [0-9]+ `.` [0-9]+ ([eE] [+-]? [0-9]+)? | [0-9]+ [eE] [+-]? [0-9]+
rule number = [0-9]+
end
