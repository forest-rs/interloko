grammar base-loko
rule source-file = definition*
rule definition = class-definition | generic-definition | method-definition | function-definition | constant-definition
rule class-definition = `define` `class` type-definition-name superclass? slot-declaration* `end` `;`?
rule type-definition-name = type-name
rule superclass = `(` superclass-type `)`
rule superclass-type = type-name
rule slot-declaration = constant-slot-declaration | mutable-slot-declaration
rule constant-slot-declaration = `constant` `slot` slot-name type-annotation? slot-option-tail* `;`
rule mutable-slot-declaration = `slot` slot-name type-annotation? slot-option-tail* `;`
rule slot-name = name
rule slot-option-tail = `,` slot-option
rule slot-option = init-value-option | init-keyword-option | required-init-keyword-option | extension-slot-option
rule init-value-option = `init-value` `:` expression
rule init-keyword-option = `init-keyword` `:` slot-keyword
rule required-init-keyword-option = `required-init-keyword` `:` slot-keyword
rule extension-slot-option = name `:` slot-keyword
rule slot-keyword = name `:`
rule generic-definition = `define` `generic` value-definition-name `(` parameter-list? `)` result-annotation? `;`
rule method-definition = `define` `method` value-definition-name `(` parameter-list? `)` result-annotation? body `end` `;`?
rule function-definition = `define` `function` value-definition-name `(` parameter-list? `)` result-annotation? body `end` `;`?
rule constant-definition = `define` `constant` value-definition-name type-annotation? `=` expression `;`
rule value-definition-name = name
rule parameter-list = trailing-list-of<parameter, `,`>
rule parameter = parameter-name type-annotation?
rule parameter-name = name
rule result-annotation = `=>` result-annotation-value
rule result-annotation-value = type-annotation-value | result-annotation-values
rule result-annotation-values = `(` trailing-list-of<type-annotation-value, `,`>? `)`
rule type-annotation = `::` type-annotation-value
rule type-annotation-value = callable-type | nominal-type
rule callable-type = `callable` `(` callable-parameter-types? `)` result-annotation
rule callable-parameter-types = trailing-list-of<type-annotation-value, `,`>
rule nominal-type = class-object-annotation-type | annotation-type
rule class-object-annotation-type = class-object-type annotation-type
rule annotation-type = type-name
rule class-object-type = `class`
rule body = let-statement* expression?
rule let-statement = `let` let-binding `=` expression `;`
rule let-binding = let-name-binding | let-values-binding
rule let-name-binding = let-name type-annotation?
rule let-name = name
rule let-values-binding = `(` trailing-list-of<let-name-binding, `,`> `)`
rule expression = handle-expression | block-expression | if-expression | assignment-expression
rule handle-expression = `handle` expression `with` restart-clause `end`
rule restart-clause = `restart` restart-condition restart-guard? expression
rule restart-guard = `when` expression `=>`
rule restart-condition = restart-parameter | restart-condition-type
rule restart-parameter = restart-name type-annotation
rule restart-name = name
rule restart-condition-type = type-name
rule block-expression = `block` `(` block-exit-name? `)` body cleanup-clause? `end`
rule block-exit-name = name
rule cleanup-clause = `cleanup` body
rule if-expression = `if` expression `then` expression `else` expression `end`
rule assignment-expression = assignment-target `:=` expression | comparison-expression
rule assignment-target = postfix-expression
rule comparison-expression = additive-expression comparison-tail?
rule comparison-tail = comparison-op additive-expression
rule comparison-op = `=` | `<=` | `<` | `>=` | `>`
rule additive-expression = multiplicative-expression (add-op multiplicative-expression)*
rule add-op = `+` | `-`
rule multiplicative-expression = unary-expression (mul-op unary-expression)*
rule mul-op = `*` | `/`
rule unary-expression = negative-expression | postfix-expression
rule negative-expression = `-` unary-expression
rule postfix-expression = primary-expression (`.` member-name)*
rule member-name = name
rule primary-expression = function-expression | vector-expression | parenthesized-expression | call-expression | keyword-symbol | bool-literal | string-literal | symbol-literal | number-literal | type-expression | name-expression
rule function-expression = `function` `(` parameter-list? `)` result-annotation? body `end`
rule parenthesized-expression = `(` expression `)`
rule vector-expression = `#[` vector-items? `]`
rule vector-items = trailing-list-of<expression, `,`>
rule call-expression = call-name `(` argument-list? `)`
rule call-name = name
rule argument-list = trailing-list-of<argument, `,`>
rule argument = keyword-argument | expression
rule keyword-argument = argument-keyword expression
rule argument-keyword = name `:`
rule name-expression = name
rule type-expression = expression-type-name
rule expression-type-name = type-name
rule number-literal = number
rule bool-literal = `#t` | `#f`
rule string-literal raw = `"` until(`"`) `"`
rule symbol-literal = `#` name
rule keyword-symbol = explicit-keyword-symbol | expression-keyword-symbol
rule explicit-keyword-symbol = `#:` name
rule expression-keyword-symbol = name `:`
rule name = [$A-Za-z_] [A-Za-z0-9_?-]*
rule number raw = [0-9]+ (`.` [0-9]+)? ([eE] [+-]? [0-9]+)?
rule type-name = `<` name `>`
rule list-of<elem, sep> = elem (sep elem)*
rule trailing-list-of<elem, sep> = list-of<elem, sep> sep?
end
