grammar base-loko
rule source-file = definition*
rule definition = class-definition | generic-definition | method-definition | function-definition | constant-definition
rule class-definition = `define` class-adjective* `class` type-definition-name superclass? slot-declaration* `end` `;`?
rule class-adjective = `sealed` | `open` | `abstract` | `concrete`
rule type-definition-name = type-name
rule superclass = `(` superclass-type `)`
rule superclass-type = type-name
rule slot-declaration = constant-slot-declaration | mutable-slot-declaration
rule constant-slot-declaration = `constant` `slot` slot-name type-annotation? slot-option-tail* `;`
rule mutable-slot-declaration = `slot` slot-name type-annotation? slot-option-tail* `;`
rule slot-name = name
rule slot-option-tail = `,` slot-option
rule slot-option = init-value-option | init-keyword-option | required-init-keyword-option | extension-slot-option
rule init-value-option = `init-value` `:` expression
rule init-keyword-option = `init-keyword` `:` slot-keyword
rule required-init-keyword-option = `required-init-keyword` `:` slot-keyword
rule extension-slot-option = name `:` slot-keyword
rule slot-keyword = name `:`
rule generic-definition = `define` generic-adjective* `generic` value-definition-name `(` parameter-list? `)` result-annotation? `;`
rule method-definition = `define` definition-adjective* `method` value-definition-name `(` parameter-list? `)` result-annotation? body `end` `;`?
rule function-definition = `define` definition-adjective* `function` value-definition-name `(` parameter-list? `)` result-annotation? body `end` `;`?
rule constant-definition = `define` definition-adjective* `constant` value-definition-name type-annotation? `=` expression `;`
rule value-definition-name = name
rule generic-adjective = `sealed` | `open` | `strict`
rule definition-adjective = `strict`
rule parameter-list = keyword-parameters | trailing-list-of<parameter, `,`> keyword-parameters?
rule keyword-parameters = `#key` trailing-list-of<keyword-parameter, `,`>
rule keyword-parameter = keyword-parameter-name type-annotation? keyword-default?
rule keyword-parameter-name = name
rule keyword-default = `=` expression
rule parameter = parameter-name type-annotation?
rule parameter-name = name
rule result-annotation = `=>` result-annotation-value
rule result-annotation-value = type-annotation-value | result-annotation-values
rule result-annotation-values = `(` trailing-list-of<type-annotation-value, `,`>? `)`
rule type-annotation = `::` type-annotation-value
rule type-annotation-value = callable-type | limited-type | nominal-type
rule callable-type = `callable` `(` callable-parameter-types? `)` result-annotation
rule callable-parameter-types = callable-keyword-types | trailing-list-of<type-annotation-value, `,`> callable-keyword-types?
rule callable-keyword-types = `#key` trailing-list-of<callable-keyword-type, `,`>
rule callable-keyword-type = name type-annotation
rule limited-type = `limited` `(` annotation-type limited-option* `)`
rule limited-option = `,` limited-keyword limited-bound
rule limited-keyword = name `:`
rule limited-bound = `-`? number
rule nominal-type = class-object-annotation-type | annotation-type
rule class-object-annotation-type = class-object-type annotation-type
rule annotation-type = type-name
rule class-object-type = `class`
rule body = body-statement* expression?
rule body-statement = let-statement | expression-statement
rule expression-statement = expression `;` !case-label
rule let-statement = `let` let-binding `=` expression `;`
rule let-binding = let-name-binding | let-values-binding
rule let-name-binding = let-name type-annotation?
rule let-name = name
rule let-values-binding = `(` trailing-list-of<let-name-binding, `,`> `)`
rule expression = assignment-expression
rule handle-expression = `handle` body `with` restart-clause `end`
rule restart-clause = `restart` restart-condition restart-guard? body
rule restart-guard = `when` expression `=>`
rule restart-condition = restart-parameter | restart-condition-type
rule restart-parameter = restart-name type-annotation
rule restart-name = name
rule restart-condition-type = type-name
rule block-expression = `block` `(` block-exit-name? `)` body cleanup-clause? exception-clause? `end`
rule begin-expression = `begin` body `end`
rule block-exit-name = name
rule cleanup-clause = `cleanup` body
// Dylan's `exception (e :: <c>) body`: a restart for the block's body that
// runs after its cleanup, as `handle` would.
rule exception-clause = `exception` `(` restart-condition `)` body
rule while-expression = `while` `(` expression `)` body `end`
rule until-expression = `until` `(` expression `)` body `end`
rule for-expression = `for` `(` trailing-list-of<for-clause, `,`> `)` body `end`
rule for-clause = collection-for-clause | numeric-for-clause
rule collection-for-clause = let-name-binding `in` expression
rule numeric-for-clause = let-name-binding `from` expression for-bound? for-step?
rule for-bound = for-bound-word expression
rule for-bound-word = `to` | `below` | `above`
rule for-step = `by` expression
rule if-expression = `if` `(` expression `)` body elseif-clause* else-clause? `end`
rule elseif-clause = `elseif` `(` expression `)` body
rule else-clause = `else` body
rule unless-expression = `unless` `(` expression `)` body `end`
rule case-expression = `case` case-clause* otherwise-clause? `end`
rule case-clause = expression `=>` body case-clause-end
rule case-clause-end = `;` | &`end`
rule case-label = list-of<expression, `,`> `=>` | `otherwise` `=>`
rule otherwise-clause = `otherwise` `=>` body `;`?
rule select-expression = `select` `(` expression select-test? `)` select-clause* otherwise-clause? `end`
rule select-test = `by` expression
rule select-clause = list-of<expression, `,`> `=>` body case-clause-end
rule assignment-expression = assignment-target `:=` expression | logical-expression
rule logical-expression = comparison-expression (logical-op comparison-expression)*
rule logical-op = `&` | `|`
rule assignment-target = postfix-expression
rule comparison-expression = additive-expression comparison-tail?
rule comparison-tail = comparison-op additive-expression
rule comparison-op = `==` | `=` | `~==` | `~=` | `<=` | `<` | `>=` | `>`
rule additive-expression = multiplicative-expression (add-op multiplicative-expression)*
rule add-op = `+%` | `-%` | `+` | `-`
rule multiplicative-expression = power-expression (mul-op power-expression)*
rule mul-op = `*%` | `*` | `/`
// `^` associates to the right, and as in Dylan a unary operator binds
// tighter than any binary one: `-2 ^ 2` is `(-2) ^ 2`.
rule power-expression = unary-expression (`^` power-expression)?
rule unary-expression = negative-expression | not-expression | postfix-expression
rule negative-expression = `-` unary-expression
rule not-expression = `~` unary-expression
rule postfix-expression = primary-expression (`.` member-name | index-access | call-arguments)*
rule member-name = name
rule index-access = `[` expression `]`
rule call-arguments = `(` argument-list? `)`
// As in Dylan, a statement is an operand: `x + if (c) 1 else 2 end`.
rule primary-expression = statement | method-expression | vector-expression | parenthesized-expression | call-expression | keyword-symbol | bool-literal | string-literal | character-literal | symbol-literal | number-literal | type-expression | name-expression
rule statement = handle-expression | block-expression | begin-expression | while-expression | until-expression | for-expression | if-expression | unless-expression | case-expression | select-expression
rule method-expression = `method` `(` parameter-list? `)` result-annotation? body `end`
rule parenthesized-expression = `(` expression `)`
rule vector-expression = `#[` vector-items? `]`
rule vector-items = trailing-list-of<expression, `,`>
rule call-expression = call-name `(` argument-list? `)`
rule call-name = name
rule argument-list = trailing-list-of<argument, `,`>
rule argument = keyword-argument | expression
rule keyword-argument = argument-keyword expression
rule argument-keyword = (name | `end`) `:`
rule name-expression = name
rule type-expression = expression-type-name
rule expression-type-name = type-name
rule number-literal = number
rule bool-literal = `#t` | `#f`
rule string-literal raw = `"` until(`"`) `"`
rule character-literal raw = `'` (`\` [^\n] [^'\n]* | [^'\\\n] [^'\n]*) `'`
rule symbol-literal = `#` symbol-name
rule keyword-symbol = explicit-keyword-symbol | expression-keyword-symbol
rule explicit-keyword-symbol = `#:` name
rule expression-keyword-symbol = name `:` !`=`
rule name raw = [$A-Za-z_] ([A-Za-z0-9_?!-] | `/` !`/`)*
// A symbol's name may be a reserved word, as in `#end`: unlike `name`, it
// takes no reserved-word exclusion, since `#` already sets it apart.
rule symbol-name raw = [$A-Za-z_] ([A-Za-z0-9_?!-] | `/` !`/`)*
rule number raw = [0-9]+ (`.` [0-9]+)? ([eE] [+-]? [0-9]+)? (`i32` | `u32` | `f32`)?
rule type-name = `<` type-name-word `>`
rule type-name-word = [$A-Za-z_] [A-Za-z0-9_?-]*
rule list-of<elem, sep> = elem (sep elem)*
rule trailing-list-of<elem, sep> = list-of<elem, sep> sep?
end
