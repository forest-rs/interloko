// expect: run 6
// expect: diagnostics 0

// A slot default may convert a boxed number with `as`, as any code may:
// the default runs in a frame of its own, which holds the value `as` tests.

define constant $held :: <object> = 3;

define class <couple> (<object>)
  slot whole :: <integer> = as(<integer>, $held);
  slot real :: <double-float> = as(<double-float>, $held);
end;

define function main() => <integer>
  let p = make(<couple>);
  p.whole + as(<integer>, p.real)
end;
