// expect: run 22
// expect: diagnostics 0

// The target's value is the one it had before any key ran, even when a
// key assigns the local it names.

define function main() => <integer>
  let n = 1;
  let picked = select (n)
    (n := 2) => 10;
    1 => 20;
    otherwise => 30;
  end;
  picked + n
end;
