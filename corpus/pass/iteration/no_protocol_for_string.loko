// expect: runtime code dispatch.no-applicable-method
// expect: diagnostics 0

// A `<string>` has no `forward-iteration-protocol` method yet, and is not
// yet a `<sequence>`: iterating one is a send no method accepts.

define function count(c :: <object>) => <integer>
  let n = 0;
  for (x in c) n := n + 1 end;
  n
end;

define function main() => <integer>
  count("abc")
end;
