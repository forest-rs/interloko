// expect: run 3
// expect: diagnostics 0
// expect: dump typing contains method describe(<circle>) strict=generic(describe)
// expect: dump typing contains method describe(<square>) strict=generic(describe)
// expect: dump typing contains strict scope=declared overflow=runtime definitions=2 errors=0

// `define strict generic` holds every method of the generic to strict
// typing, as if each were `define strict method`. Each method here sends
// only on its own specializer, which typing proves.

define class <shape> (<object>)
end;

define class <circle> (<shape>)
end;

define class <square> (<shape>)
end;

define generic sides(s :: <shape>) => <integer>;

define method sides(c :: <circle>) => <integer>
  0
end;

define method sides(s :: <square>) => <integer>
  4
end;

define strict generic describe(s :: <shape>) => <integer>;

define method describe(c :: <circle>) => <integer>
  sides(c) - 1
end;

define method describe(s :: <square>) => <integer>
  sides(s)
end;

define function main() => <integer>
  describe(make(<circle>)) + describe(make(<square>))
end;
