// typing: strict
// expect: run 3
// expect: diagnostics 0

// The kernel's list methods and collection functions are written in
// Loko, but they are the kernel's code, not the program's: holding every
// definition to strict typing holds only the program's.

define function main() => <integer>
  if (member?(2, #(1, 2))) size(#(1, 2, 3)) else 0 end
end;
