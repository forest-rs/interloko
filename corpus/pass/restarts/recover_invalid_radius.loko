// expect: run 0
// expect: diagnostics 0
// expect: dump ast contains handle
// expect: dump sem contains signal
// expect: dump sem contains condition=l
// expect: dump sem contains accessor-call
// expect: dump lowered contains jmp

define class <circle> (<object>)
  slot radius :: <integer>;
end;

define class <invalid-radius> (<object>)
  slot fallback :: <integer>;
end;

define generic area(x);

define method area(c :: <circle>)
  handle
    if c.radius < 0 then
      signal(make(<invalid-radius>, fallback: 0))
    else
      c.radius * c.radius
    end
  with restart e :: <invalid-radius>
    e.fallback
  end
end;

define function main()
  area(make(<circle>, radius: 0 - 10))
end;
