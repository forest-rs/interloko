// expect: run 161.0
// expect: diagnostics 0
// expect: dump lowered contains take-i32#closure#boxed(%r1 $env: agg, %r2 arg0: any) -> any

// An untyped call whose shape differs from the callee's passes and returns
// its values boxed, so a value of the class a function declares reaches it
// whatever the caller holds: an `<integer>` in an `<i32>`'s range, an
// `<integer>` for an `<object>`, a boxed `<circle>` for a `<circle>`, and an
// `<object>` result holding the `<double-float>` the caller wants. A call
// whose shape matches, such as of a closure taking a `<boolean>`, calls it
// directly.

define class <circle> (<object>)
  slot radius :: <integer>;
end;

define function take-i32(x :: <i32>) => <i32>
  x + 1i32
end;

define function hold(x :: <object>) => <object>
  x
end;

define function radius-of(c :: <circle>) => <integer>
  c.radius
end;

define function half(n :: <integer>) => <object>
  as(<object>, as(<double-float>, n) / 2.0)
end;

define function call(f :: <callable>, x :: <object>) => <object>
  apply(f, x)
end;

define function main() => <double-float>
  let small :: <integer> = as(<integer>, call(take-i32, 41));
  let held :: <integer> = as(<integer>, call(hold, 50));
  let measured :: <integer> = as(<integer>, call(radius-of, make(<circle>, radius: 60)));
  let flip :: <callable> = function (b :: <boolean>) => <integer> if b then 9 else 0 end end;
  let flipped :: <integer> = apply(flip, #t);
  let halver :: <callable> = half;
  let halved :: <double-float> = apply(halver, 1);
  as(<double-float>, small + held + measured + flipped) + halved - 0.5
end;
