// expect: run "1.4142135f32 -2.0f32 0.5f32 #t"
// expect: diagnostics 0
// expect: dump lowered contains f32.sqrt
// expect: dump lowered contains f32.floor
// expect: dump lowered contains f32.min
// expect: dump lowered contains f32.ne

// The float library works on single-floats too: operations with a tape
// instruction stay in binary32, and a literal argument beside a
// single-float is one. `float-to-string` keeps the `f32` suffix, so the
// text reads back as the same value.
define function flag(b :: <boolean>) => <string>
  if b then "#t" else "#f" end
end;

define function main() => <string>
  let root = sqrt(2.0f32);
  let low = floor(-1.5f32);
  let clamped = min(0.75f32, 0.5);
  let ok = if nan?(root) then #f else finite?(low) end;
  concatenate(
    concatenate(concatenate(float-to-string(root), " "), concatenate(float-to-string(low), " ")),
    concatenate(concatenate(float-to-string(clamped), " "), flag(ok)))
end;
