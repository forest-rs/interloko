// expect: run 324
// expect: diagnostics 0
// expect: dump lowered contains cell.new
// expect: dump lowered contains cell.set

// Dylan's `local method name (…) … end, method other (…) … end;` binds
// methods for the rest of a body. Every name of a group is in scope in
// each of its methods, so they recurse, by themselves or together; they
// capture the body's locals as any closure does, and a binding of one is
// a function value. A method that writes its results is called through
// them, even from within its group; one that does not is called as an
// untyped value there, and as itself after the group.

define function main() => <integer>
  let base = 100;
  local method even? (n :: <integer>) => <boolean>
          if (n = 0) #t else odd?(n - 1) end
        end,
        method odd? (n :: <integer>) => <boolean>
          if (n = 0) #f else even?(n - 1) end
        end,
        method fact (n :: <integer>) => <integer>
          if (n < 2) 1 else n * fact(n - 1) end
        end,
        method add-base (x) base + x end;
  local method fib (n) if (n < 2) n else fib(n - 1) + fib(n - 2) end end;
  local method count (#rest xs) size(xs) end;
  let f :: <function> = fact;
  let r :: <integer> = f(5);
  let a :: <integer> = add-base(1);
  let b :: <integer> = fib(10);
  (if (even?(10) & odd?(7)) 1 else 0 end)  // 1
    + r                                    // 120
    + a                                    // 101
    + count(1, 2, 3)                       // 3
    + b + 44                               // 55 + 44
end;
