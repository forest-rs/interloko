// expect: run 4
// expect: diagnostics 0
// expect: dump lowered contains a#closure
// expect: dump lowered contains b#closure

// Callable thunks are emitted in function order; `b` is taken as a value
// before `a` here, and both thunks still line up with their ids.

define function a(x :: <integer>) => <integer>
  x + 1
end;

define function b(x :: <integer>) => <integer>
  x + 2
end;

define function call-with(f :: <callable>, x :: <integer>) => <integer>
  f(x)
end;

define function main()
  call-with(b, call-with(a, 1))
end;
