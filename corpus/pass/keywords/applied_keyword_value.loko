// expect: run 7
// expect: diagnostics 0
// `apply` passes no keywords, so the value fills every default; `element`
// is a value that takes its `default` keyword like any other.

define function scale(x :: <integer>, #key by :: <integer> = 2) => <integer>
  x * by
end;

define function lookup(f :: <callable>) => <integer>
  let r :: <integer> = f(#[1], 5, default: 1);
  r
end;

define function main() => <integer>
  let f = element;
  as(<integer>, apply(f, #[0], 0)) + apply(scale, 3) + lookup(element)
end;
