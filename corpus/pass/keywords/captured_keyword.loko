// expect: run 15
// expect: diagnostics 0
// A keyword parameter is a parameter like any other, so a closure can
// capture it.

define function adder(#key by :: <integer> = 5) => callable(<integer>) => <integer>
  method (x :: <integer>) => <integer> x + by end
end;

define function main() => <integer>
  let a = adder();
  let b = adder(by: 3);
  a(4) + b(3)
end;
