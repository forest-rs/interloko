// expect: run 21
// expect: diagnostics 3
// expect: diagnostic code typing.range-always-outside
// expect: dump sem contains instance? <u32>

// `instance?(x, <u32>)` asks whether `x` is an `<integer>` in the range;
// floats never are, whatever their value. Soft typing warns about the three
// literal tests that are always false.
define function score(x :: <object>) => <integer>
  if (instance?(x, <u32>)) 1 else 0 end
end;

define function main() => <integer>
  let negative = -1i32;
  let wide :: <integer> = 4294967296;
  let top :: <u32> = 4294967295;
  score(7) * 10
    + score(-1)
    + score(7.0)
    + (if (instance?(negative, <u32>)) 100 else 0 end)
    + (if (instance?(wide, <u32>)) 100 else 0 end)
    + (if (instance?(top, <i32>)) 100 else 0 end)
    + (if (instance?(top, <u32>)) 11 else 0 end)
end;
