// expect: run -0.0
// expect: diagnostics 0

// Boxing preserves exact values: wide integers fall back to heap boxes,
// and floats keep their bits, including the sign of zero.
define generic keep(x :: <object>) => <object>;

define method keep(x :: <object>) => <object>
  x
end;

define function main() => <float>
  let small = as(<integer>, keep(70368744177663));
  let wide = as(<integer>, keep(-9223372036854775808));
  if small = 70368744177663 then
    if wide = -9223372036854775808 then as(<double-float>, keep(-0.0)) else 1.0 end
  else
    2.0
  end
end;
