// expect: run 3
// expect: dump sem contains literal.symbol
define function same-symbol(a :: <symbol>, b :: <symbol>) => <boolean>
  a = b
end;

define function main()
  let hash-symbol-score = if same-symbol(#ready, #ready) then 1 else 0 end;
  let keyword-symbol-score = if same-symbol(fallback:, fallback:) then 2 else 0 end;
  hash-symbol-score + keyword-symbol-score
end;
