// expect: run 2
// expect: diagnostics 0

// A send that returns several values where one is expected keeps the
// first, as in Dylan.

define class <source> (<object>)
end;

define generic split(x :: <object>) => (<integer>, <integer>);

define method split(x :: <source>) => (<integer>, <integer>)
  values(1, 2)
end;

define function main()
  split(make(<source>)) + 1
end;
