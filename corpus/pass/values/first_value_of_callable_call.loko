// expect: run 2
// expect: diagnostics 0

// A call through a `<callable>` that returns several values where one is
// expected keeps the first, as in Dylan.

define function split(flag :: <boolean>) => (<integer>, <integer>)
  if (flag)
    values(1, 2)
  else
    values(3, 4)
  end
end;

define function callit(f :: <callable>) => (<integer>, <integer>)
  f(#t)
end;

define function main()
  callit(split) + 1
end;
