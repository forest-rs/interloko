// expect: run 13
// expect: diagnostics 0
// expect: dump typing contains s0 dispatch proved rule=dispatch-covered
// expect: dump typing contains actual=<shape>
// expect: dump typing contains closed-world(sealed abstract class <shape> has exactly direct subclasses {<circle>, <square>})
// expect: dump typing contains closed-world(generic area has exactly methods {area(<circle>), area(<square>)})

// `<shape>` is sealed and abstract, so a <shape> is a <circle> or a
// <square>, and `area` has a method for each: the send in `measure` is
// proved, recording both closed-world assumptions it relies on. Open, the
// same send is left to the runtime.

define sealed abstract class <shape> (<object>)
end;

define class <circle> (<shape>)
  slot radius :: <integer>;
end;

define class <square> (<shape>)
  slot side :: <integer>;
end;

define generic area(s :: <shape>) => <integer>;

define method area(c :: <circle>) => <integer>
  3 * c.radius * c.radius
end;

define method area(s :: <square>) => <integer>
  s.side * s.side
end;

define function measure(s :: <shape>) => <integer>
  area(s)
end;

define function main() => <integer>
  measure(make(<circle>, radius: 1)) + measure(make(<square>, side: 3)) + 1
end;
