// typing: silent
// expect: run 27
// expect: diagnostics 0
// expect: dump typing contains s1 instance checked rule=instance-sometimes
// expect: dump typing contains expected=<square> actual=type-union(<square>, <triangle>)
// expect: dump typing contains s2 cast proved rule=cast-upcast
// expect: dump typing contains expected=<triangle> actual=<triangle> severity=silent origin=explicit because=narrowed(s1,else)

// `case` arms narrow the way `elseif` arms do: the `otherwise` body sees
// that neither test held, so over a sealed hierarchy only `<triangle>`
// is left and its cast is proved.

define sealed abstract class <shape> (<object>)
end;

define class <circle> (<shape>)
end;

define class <square> (<shape>)
end;

define class <triangle> (<shape>)
  slot base :: <integer>;
end;

define function size(s :: <shape>) => <integer>
  case
    instance?(s, <circle>) => 1;
    instance?(s, <square>) => 20;
    otherwise => as(<triangle>, s).base;
  end
end;

define function main() => <integer>
  size(make(<circle>)) + size(make(<square>)) + size(make(<triangle>, base: 6))
end;
