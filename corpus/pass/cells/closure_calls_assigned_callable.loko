// expect: run 110
// expect: diagnostics 0

// A closure that calls a local callable refers to it, so when the frame
// assigns the callable afterwards, the closure calls the new one.

define function main() => <integer>
  let f :: callable(<integer>) => <integer> = method (n :: <integer>) => <integer> n end;
  let g = method () => <integer> f(10) end;
  f := method (n :: <integer>) => <integer> n + 100 end;
  g()
end;
