// expect: run 40
// expect: diagnostics 0

// A restart guard calling a local callable sees the callable the handled
// body stored after the guard was made.

define class <oops> (<error>)
end;

define function main() => <integer>
  let ok :: callable() => <boolean> = function () => <boolean> #f end;
  handle block ()
    ok := function () => <boolean> #t end;
    signal(make(<oops>))
  end
  with restart c :: <oops> when ok() => 40 end
end;
