// expect: run 30
// expect: diagnostics 0

// A `select`'s `by` test is read once too, so a key that replaces the
// test's local does not change the test the other keys use.

define function main() => <integer>
  let t :: callable(<integer>, <integer>) => <boolean>
    = function (a :: <integer>, b :: <integer>) => <boolean> #f end;
  let swap = function () => <integer>
    t := function (a :: <integer>, b :: <integer>) => <boolean> #t end;
    5
  end;
  select (1 by t)
    swap() => 10;
    7 => 20;
    otherwise => 30;
  end
end;
