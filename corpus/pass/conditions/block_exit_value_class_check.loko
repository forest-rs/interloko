// expect: runtime code type-error.entry
// expect: diagnostics 0
// expect: dump lowered contains as <circle>

// An exit procedure is a first-class callable: whoever calls it through an
// untyped `<callable>` may pass any class, so the exit checks its values
// against the block's result classes before delivering them.

define class <circle> (<object>)
  slot radius :: <integer>;
end;

define class <square> (<object>)
  slot side :: <integer>;
end;

define function deliver(f :: <callable>, s :: <square>) => <circle>
  apply(f, s)
end;

define function main()
  let c :: <circle> = block (done)
    let ignored = deliver(done, make(<square>, side: 9));
    make(<circle>, radius: 1)
  end;
  c.radius
end;
