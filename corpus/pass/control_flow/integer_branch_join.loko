// expect: run 3
// expect: diagnostics 0

// Branches of different integer types join at `<integer>`, which holds
// both, in either order, and a `<u32>` block body widens to an
// `<integer>` exit.
define function pick(c :: <boolean>, k :: <i32>) => <integer>
  if c then 0 else k end
end;

define function other(c :: <boolean>, k :: <u32>) => <integer>
  if c then k else -1 end
end;

define function main() => <integer>
  let small :: <u32> = 4;
  let r :: <integer> = block (return) small end;
  pick(#f, 3) + other(#f, 7u32) + r - 3
end;
