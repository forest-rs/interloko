// expect: run 1
// expect: diagnostics 0
// expect: dump sem contains origin=slot-getter sealing=open
// expect: dump sem contains known-callable(generic radius)

// A slot's getter is a generic function, as in Dylan, so naming it as a
// value names the generic.

define class <circle> (<object>)
  slot radius :: <integer>;
end;

define function main()
  let getter = radius;
  1
end;
