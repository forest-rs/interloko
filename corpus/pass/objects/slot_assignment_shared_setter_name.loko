// expect: run 16
// expect: diagnostics 0

define class <circle> (<object>)
  slot radius :: <integer>;
end;

define class <sphere> (<object>)
  slot radius :: <integer>;
end;

define function main()
  let c = make(<circle>, radius: 5);
  let s = make(<sphere>, radius: 6);
  let ignored_circle = c.radius := 7;
  let ignored_sphere = s.radius := 9;
  c.radius + s.radius
end;
