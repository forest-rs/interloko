// expect: run 8
// expect: diagnostics 0
// expect: dump ast contains instance? <circle>
// expect: dump sem contains refinement l0 => object(c0)
// expect: dump sem contains local l0 as object(c0)
// expect: dump lowered contains instance?
// expect: dump lowered contains as <circle>
// expect: dump tape contains interloko.instance_of
// expect: dump tape contains interloko.cast_object

define class <circle> (<object>)
  slot radius :: <integer>;
end;

define function radius-or-zero(x :: <object>) => <integer>
  if instance?(x, <circle>) then x.radius else 0 end
end;

define function main()
  radius-or-zero(make(<circle>, radius: 8))
end;
