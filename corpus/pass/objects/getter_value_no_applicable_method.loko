// expect: runtime code dispatch.no-applicable-method
// expect: diagnostics 0

// A slot's getter taken as a value is its generic, so calling it on an
// instance of a class without the slot finds no method.

define class <circle> (<object>)
  slot radius :: <integer>;
end;

define class <square> (<object>)
  slot side :: <integer>;
end;

define function call-with(f :: <callable>, s :: <square>) => <integer>
  apply(f, s)
end;

define function main()
  call-with(radius, make(<square>, side: 7))
end;
