// expect: run 1
// expect: dump lowered contains runtime.method-generic-function

define class <circle> (<object>)
  slot radius :: <integer>, init-value: 10;
end;

define generic area(c :: <circle>) => <integer>;

define method area(c :: <circle>) => <integer>
  c.radius
end;

define function main() => <integer>
  let chosen = vector-ref(generic-function-methods(area), 0);
  if generic-function-name(method-generic-function(chosen)) = "area" then 1 else 0 end
end;
