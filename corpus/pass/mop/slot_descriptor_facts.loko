// expect: run 5
// expect: dump lowered contains runtime.slot-name
// expect: dump lowered contains runtime.slot-type
// expect: dump lowered contains runtime.slot-init-keyword
// expect: dump lowered contains runtime.slot-mutable?
// expect: dump lowered contains runtime.slot-getter

define class <circle> (<object>)
  slot radius :: <integer>, init-keyword: r:, init-value: 10;
end;

define function main() => <integer>
  let descriptor = vector-ref(class-effective-slots(<circle>), 0);
  if slot-name(descriptor) = "radius"
  then if slot-type(descriptor) = "<integer>"
       then if slot-init-keyword(descriptor) = "r"
            then if slot-mutable?(descriptor)
                 then if slot-getter(descriptor) = "radius" then 5 else 0 end
                 else 0
                 end
            else 0
            end
       else 0
       end
  else 0
  end
end;
