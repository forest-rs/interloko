// expect: run 2
// expect: dump sem contains generic-function-object g0
// expect: dump lowered contains runtime.generic-function-methods

define class <shape> (<object>)
  slot size :: <integer>, init-value: 1;
end;

define class <circle> (<shape>)
  slot radius :: <integer>, init-value: 10;
end;

define generic score(x :: <shape>) => <integer>;

define method score(s :: <shape>) => <integer>
  s.size
end;

define method score(c :: <circle>) => <integer>
  c.radius
end;

define function main() => <integer>
  if generic-function-name(score) = "score"
  then vector-size(generic-function-methods(score))
  else 0
  end
end;
