// expect: run 3
// expect: dump sem contains intrinsic object-class
// expect: dump lowered contains runtime.object-class

define class <circle> (<object>)
  slot radius :: <integer>, init-value: 10;
end;

define function main() => <integer>
  let c = make(<circle>, radius: 12);
  if class-name(object-class(c)) = "<circle>"
  then if class-name(object-class(1)) = "<integer>"
       then if class-name(object-class(<circle>)) = "<class>" then 3 else 0 end
       else 0
       end
  else 0
  end
end;
