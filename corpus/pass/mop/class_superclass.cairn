// expect: run 1
// expect: dump lowered contains runtime.class-direct-superclass

define class <shape> (<object>)
  slot size :: <integer>, init-value: 1;
end;

define class <circle> (<shape>)
  slot radius :: <integer>, init-value: 10;
end;

define function main() => <integer>
  if class-name(class-direct-superclass(<circle>)) = "<shape>" then 1 else 0 end
end;
