// expect: run 9
// expect: diagnostics 1
// expect: diagnostic code typing.dispatch-no-applicable-method
// expect: diagnostic contains no method of `whole` can apply to <double-float>
// expect: dump typing contains dispatch proved rule=dispatch-covered
// expect: dump typing contains actual=<double-float> severity=silent
// expect: dump typing contains cast proved rule=cast-upcast
// expect: dump typing contains dispatch checked rule=dispatch-needs-runtime-class
// expect: dump typing contains dispatch refuted rule=dispatch-no-applicable-method
// expect: dump typing contains expected=dispatch whole methods=1 boxed-params=0

// Float values are exactly `<double-float>`, which sits under the abstract
// `<float>`: methods on either class cover them, and widening to `<float>`
// needs no runtime check. An `<object>` argument leaves method selection to
// the runtime, and an `<integer>`-only generic never accepts a float; that
// call is in a branch that is never taken, so the program still runs.

define generic size-of(x);

define method size-of(x :: <double-float>)
  1
end;

define method size-of(x :: <integer>)
  2
end;

define generic magnitude(x :: <float>) => <integer>;

define method magnitude(x :: <float>) => <integer>
  5
end;

define generic whole(x);

define method whole(x :: <integer>)
  x
end;

define function widen(x :: <double-float>) => <float>
  as(<float>, x)
end;

define function on-object(x :: <object>)
  size-of(x)
end;

define function main()
  if 1 < 2 then
    size-of(2.5) + size-of(3) + magnitude(widen(2.5)) + on-object(as(<object>, 2.5))
  else
    whole(2.5)
  end
end;
