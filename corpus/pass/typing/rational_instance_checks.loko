// expect: run 111
// expect: diagnostics 4
// expect: diagnostic code typing.instance-always-true
// expect: diagnostic code typing.instance-always-false

// Integers are `<rational>`; floats are `<real>` but not `<rational>`.
// (`instance?(2.5, <rational>)` is rejected statically as impossible.) Soft
// typing decides every remaining test too, even through the `<object>`
// upcast, so each one warns.
define function bit(flag :: <boolean>, weight :: <integer>) => <integer>
  if (flag) weight else 0 end
end;

define function main() => <integer>
  bit(instance?(3, <rational>), 1)
    + bit(instance?(3, <real>), 10)
    + bit(instance?(2.5, <real>), 100)
    + bit(instance?(as(<object>, 2.5), <rational>), 10000)
end;
