// typing: strict
// expect: run 3
// expect: diagnostics 0
// expect: dump typing contains config=strict
// expect: dump typing contains strict scope=all overflow=runtime definitions=2 errors=0
// expect: dump typing contains s0 cast checked rule=cast-narrowing
// expect: dump typing contains severity=silent origin=explicit

// The strict preset holds every definition to strict typing, but an
// explicit `as` is a check the program asks for: strict code keeps it at
// runtime without a finding, and the cast runs and succeeds.

define class <shape> (<object>)
  slot sides :: <integer>, init-value: 0;
end;

define class <triangle> (<shape>)
end;

define function sides-of(s :: <shape>) => <integer>
  as(<triangle>, s).sides + 3
end;

define function main()
  sides-of(make(<triangle>))
end;
