// expect: run 12
// expect: diagnostics 0
// expect: dump typing contains dispatch proved rule=dispatch-covered
// expect: dump typing contains actual=<single-float>
// expect: dump typing contains actual=<integer>
// expect: dump typing contains cast checked rule=cast-narrowing
// expect: dump lowered contains f32.add
// expect: dump lowered contains i32.add_ovf

// Soft typing knows the 32-bit kinds' classes: a `<single-float>` is
// exactly that class, and an `<i32>` or `<u32>` value is an `<integer>`.
// Dispatch on them is proved, while an `<object>` unboxed as `<u32>` still
// needs its runtime check. Statically typed arithmetic compiles to the
// 32-bit instructions directly.
define generic weight(x);

define method weight(x :: <single-float>) => <integer>
  10
end;

define method weight(x :: <integer>) => <integer>
  1
end;

define function frames(x :: <object>) => <u32>
  as(<u32>, x)
end;

define function main() => <integer>
  let gain = 0.5f32 + 0.25;
  let step = 3i32 + 4;
  weight(gain) + weight(step) + weight(frames(5)) + as(<integer>, step) - 7
end;
