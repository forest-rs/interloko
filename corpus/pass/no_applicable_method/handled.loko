// expect: run 7
// expect: diagnostics 0

// A handler for `<no-applicable-method>` reads what the failed send
// reports: its stable code, the generic, and the arguments in order. The
// handle site's recovery stands in for the whole `handle` expression.

define class <shape> (<object>)
end;

define class <circle> (<shape>)
  slot radius :: <integer>;
end;

define class <square> (<shape>)
  slot side :: <integer>;
end;

define generic scale(s :: <shape>, factor :: <integer>) => <integer>;

define method scale(c :: <circle>, factor :: <integer>) => <integer>
  c.radius * factor
end;

define function reports(e :: <no-applicable-method>) => <boolean>
  let arguments = e.no-applicable-method-arguments;
  if (e.no-applicable-method-code = "dispatch.no-applicable-method")
    if (generic-function-name(e.no-applicable-method-generic) = "scale")
      if (size(arguments) = 2)
        if (instance?(arguments[0], <square>))
          as(<integer>, arguments[1]) = 3
        else
          #f
        end
      else
        #f
      end
    else
      #f
    end
  else
    #f
  end
end;

define function scaled(s :: <shape>) => <integer>
  handle
    scale(s, 3)
  with restart e :: <no-applicable-method>
    if (reports(e)) 7 else 0 end
  end
end;

define function main() => <integer>
  scaled(make(<square>, side: 2))
end;
