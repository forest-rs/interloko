// expect: run 111
// expect: diagnostics 0
// expect: dump lowered contains area#closure

// A generic used as a value sends through its closure, and `apply` sends
// the same way, so both signal `<no-applicable-method>` when no method
// accepts the arguments, as a direct send does.

define class <shape> (<object>)
end;

define class <circle> (<shape>)
  slot radius :: <integer>;
end;

define class <square> (<shape>)
  slot side :: <integer>;
end;

define generic area(s :: <shape>) => <integer>;

define method area(c :: <circle>) => <integer>
  3 * c.radius * c.radius
end;

define function through(f :: <callable>, s :: <shape>) => <integer>
  handle
    f(s)
  with restart e :: <no-applicable-method>
    100
  end
end;

define function applied(s :: <shape>) => <integer>
  handle
    apply(area, #[s])
  with restart e :: <no-applicable-method>
    10
  end
end;

define function sent(s :: <shape>) => <integer>
  handle
    area(s)
  with restart e :: <no-applicable-method>
    1
  end
end;

define function main() => <integer>
  let s = make(<square>, side: 2);
  through(area, s) + applied(s) + sent(s)
end;
