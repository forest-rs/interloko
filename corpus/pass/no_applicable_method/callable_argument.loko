// expect: runtime code dispatch.no-applicable-method
// expect: run reports called with ({<callable>})
// expect: dump lowered lacks literal.symbol

// A callable is a `<function>`, so a failed send's arguments vector holds
// it like any other argument. Here the only method takes an `<integer>`,
// so the parameter carries boxed values and a callable reaches dispatch,
// which finds no method for it.

define generic scale(x) => <integer>;

define method scale(x :: <integer>) => <integer>
  x * 2
end;

define function main() => <integer>
  scale(function (x :: <integer>) => <integer> x + 1 end)
end;
