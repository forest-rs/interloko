// expect: run 157
// expect: diagnostics 0

// `to` counts through its bound: up for a step of zero or more, down for a
// negative one, decided when the loop starts if the step is only known
// then. `above` stops once the variable reaches its bound from above, so
// it takes a negative step; the step is 1 when none is written.

define function down-by(step :: <integer>) => <integer>
  let total = 0;
  for (k from 8 to 4 by step)
    total := total + k
  end;
  total
end;

define function main() => <integer>
  let total = 0;
  // 0 + 1 + ... + 9 = 45
  for (i from 0 below 10) total := total + i end;
  // 10 + 9 + ... + 1 = 55
  for (i from 10 to 1 by -1) total := total + i end;
  // 0 + 5 + 10 = 15
  for (i from 0 to 10 by 5) total := total + i end;
  // 9 + 7 + 5 + 3 = 24
  for (i from 9 above 2 by -2) total := total + i end;
  // 8 + 6 + 4 = 18, with the direction chosen at run time
  total := total + down-by(-2);
  // A loop whose bound is already passed runs no iterations.
  for (i from 5 to 4) total := total + 1000 end;
  for (i from 5 below 5) total := total + 1000 end;
  total
end;
