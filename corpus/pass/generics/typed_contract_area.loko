// expect: run 100
// expect: diagnostics 0
// expect: dump ast contains area(x :: <object>)
// expect: dump ast contains returns <integer>
// expect: dump sem contains generic g0
// expect: dump sem contains area(x:object-top) result=I64 return=integer
// expect: dump lowered contains area#dispatch

define class <circle> (<object>)
  slot radius :: <integer>;
end;

define generic area(x :: <object>) => <integer>;

define method area(c :: <circle>) => <integer>
  c.radius * c.radius
end;

define function main()
  area(make(<circle>, radius: 10))
end;
