// expect: dump sem contains generic-function-object g0
// expect: dump sem contains generic-call g0
// expect: dump lowered contains area#dispatch

define class <circle> (<object>)
  slot radius :: <integer>;
end;

define generic area(x);

define method area(c :: <circle>)
  c.radius * c.radius
end;

define function main()
  let g = area;
  apply(g, make(<circle>, radius: 5))
end;
