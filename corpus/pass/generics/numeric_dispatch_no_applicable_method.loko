// expect: runtime code dispatch.no-applicable-method
// expect: run reports unhandled condition <no-applicable-method>: dispatch.no-applicable-method: no method of / applies to (<integer>, <integer>), called with (6, 3)
// expect: diagnostics 1
// expect: diagnostic code typing.dispatch-no-applicable-method

// Integer `/` has no method, so dispatching it on boxed integers finds no
// applicable method: soft typing warns, and the run signals a
// `<no-applicable-method>` that nothing handles. (Integer division becomes
// exact rational division later.)
define function main() => <integer>
  as(<integer>, as(<object>, 6) / 3)
end;
