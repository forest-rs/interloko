// expect: run 12u32
// expect: diagnostics 0

// A generic may declare a limited integer parameter, and its methods
// restate the limited type: they receive the unboxed `<u32>`.
define generic channel(level :: <u32>) => <u32>;

define method channel(level :: <u32>) => <u32>
  level
end;

define function main() => <u32>
  channel(12)
end;
