// expect: runtime code type-error.cast
// expect: diagnostics 0

// Calling an `<object>` checks that it is a `<function>`, as a declaration
// would, and signals a `<type-error>` when it is not.

define function main() => <integer>
  let t = make(<table>);
  t[#f] := 5;
  let result :: <integer> = t[#f](1);
  result
end;
