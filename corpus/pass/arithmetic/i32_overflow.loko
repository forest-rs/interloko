// expect: runtime code type-error.overflow
// expect: diagnostics 1
// expect: diagnostic code typing.overflow-certain

// `<i32>` arithmetic signals a `<type-error>` when the exact result leaves
// the type's range, rather than wrapping; `+%` is the explicit wrapping
// operator.
define function main() => <i32>
  let x :: <i32> = 2147483647;
  x + 1
end;
