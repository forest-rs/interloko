// expect: runtime code runtime.integer-overflow
// expect: diagnostics 1
// expect: diagnostic code typing.overflow-certain

// `<i32>` arithmetic traps when the exact result leaves the type's range,
// rather than wrapping; `+%` is the explicit wrapping operator.
define function main() => <i32>
  let x :: <i32> = 2147483647;
  x + 1
end;
