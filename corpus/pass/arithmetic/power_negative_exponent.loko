// expect: run 7
// expect: diagnostics 0

// An `<integer>` raised to a negative `<integer>` is not an integer, so the
// exponent's range check signals `type-error.range`, expecting
// `limited(<integer>, min: 0)`, and `use-value` supplies the power.

define function main() => <integer>
  let exponent = -1;
  handle
    2 ^ exponent
  with restart e :: <type-error>
    if (e.type-error-expected-type == limited(<integer>, min: 0)) 7 else 0 end
  end
end;
