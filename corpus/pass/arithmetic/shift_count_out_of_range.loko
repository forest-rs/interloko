// expect: runtime code runtime.trap
// expect: diagnostics 0
// expect: dump lowered contains trap 4 (shift count out of range)

// A shift count outside 0..=31 traps; it never silently wraps to a
// smaller shift.
define function shift(x :: <u32>, n :: <u32>) => <u32>
  shift-left(x, n)
end;

define function main() => <u32>
  shift(1, 32)
end;
