// expect: run 34
// expect: diagnostics 0

// `apply` spreads any sequence, a list as well as a vector.

define function add(a, b) a + b end;

define function main() => <integer>
  let f :: <function> = method (#rest xs) size(xs) end;
  let r :: <integer> = apply(add, list(1, 2));
  let s :: <integer> = apply(f, 1, #(2, 3, 4));
  r * 10 + s
end;
