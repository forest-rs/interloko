// expect: run 42
// expect: diagnostics 0
// Element access chains with slot reads and other accesses, left to right:
// `g.rows[1]` indexes the slot's value, and an index's value can be cast
// and indexed again. Keys are any expressions.

define class <grid> (<object>)
  slot rows :: <vector>;
end;

define function main() => <integer>
  let g = make(<grid>, rows: #[#[1, 2], #[40, 2]]);
  let i = 0;
  as(<integer>, as(<vector>, g.rows[1])[i]) + as(<integer>, as(<vector>, g.rows[i + 1])[size(g.rows) - 1])
end;
