// expect: diagnostic code sem.keyword-callable-value
// expect: diagnostics 1
// Calls through callable values pass no keywords yet, so a function that
// takes keywords cannot be used as a value, rather than losing them.

define function f(x :: <integer>, #key by :: <integer> = 2) => <integer> x * by end;
define function main() => <integer>
  let g :: callable(<integer>) => <integer> = f;
  g(1)
end;
