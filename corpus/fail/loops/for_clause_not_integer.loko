// expect: diagnostics 3
// expect: diagnostic code sem.for-clause-type-mismatch
// expect: diagnostic contains `for` clause `from` expects <integer> but has <double-float>
// expect: diagnostic contains `for` clause `below` expects <integer> but has <object>
// expect: diagnostic contains `for` clause `by` expects <integer> but has <string>

// A numeric `for` counts in `<integer>`s: its start, bound and step must
// be integers (an `<i32>` or `<u32>` widens). An `<object>` needs an `as`.

define function count(limit :: <object>) => <integer>
  let total = 0;
  for (i from 0.5 below limit by "one")
    total := total + 1
  end;
  total
end;

define function main() => <integer>
  count(3)
end;
