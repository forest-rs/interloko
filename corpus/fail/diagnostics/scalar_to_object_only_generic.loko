// expect: diagnostics 1
// expect: diagnostic code sem.no-applicable-method
// expect: diagnostic contains no method of `area` accepts <double-float> as argument 1: its methods specialize it on <circle>; pass one of those, or define a method on <double-float>

// No method of `area` can apply to a float, so its parameter carries raw
// object handles and a float argument is rejected.
define class <circle> (<object>)
  slot radius :: <double-float>;
end;

define generic area(shape);

define method area(c :: <circle>) => <double-float>
  c.radius * c.radius
end;

define function main() => <double-float>
  area(2.5)
end;
