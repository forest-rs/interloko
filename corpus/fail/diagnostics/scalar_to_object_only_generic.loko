// expect: diagnostics 1
// expect: diagnostic contains generic `area` argument 1 expects <object> but got <double-float>

// No method of `area` can apply to a float, so its parameter carries raw
// object handles and a float argument is rejected.
define class <circle> (<object>)
  slot radius :: <float>;
end;

define generic area(shape);

define method area(c :: <circle>) => <float>
  c.radius * c.radius
end;

define function main() => <float>
  area(2.5)
end;
