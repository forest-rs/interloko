// expect: diagnostics 2
// expect: diagnostic code sem.identity-operand-type-mismatch
// expect: diagnostic contains `==` compares objects, not function `twice`

// `==` compares objects, and a callable value is not one.

define function twice(x :: <integer>) => <integer>
  x * 2
end;

define function main() => <boolean>
  twice == twice
end;
