// expect: diagnostics 2
// expect: diagnostic contains expects callable(<integer>, <vector>) => <integer> but got callable(<integer>, #rest <vector>) => <integer>
// expect: diagnostic code sem.local-assignment-type-mismatch

// A value taking `#rest` gets the arguments after its required ones in a
// vector its caller makes, so it never stands in for one taking a
// `<vector>` parameter, whose caller passes one as it is, nor the other
// way round, though the two take the same registers.

define function count(a :: <integer>, #rest xs) => <integer>
  size(xs) + 10 * a
end;

define function takev(f :: callable(<integer>, <vector>) => <integer>) => <integer>
  f(1, #[7, 8, 9])
end;

define function main() => <integer>
  let f = method (a :: <integer>, #rest xs) => <integer> size(xs) end;
  f := method (a :: <integer>, v :: <vector>) => <integer> size(v) end;
  takev(count) + f(1, 2, 3)
end;
