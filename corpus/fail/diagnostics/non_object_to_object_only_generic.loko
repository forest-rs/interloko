// expect: diagnostics 2
// expect: diagnostic code sem.no-applicable-method
// expect: diagnostic contains no method of `area` accepts <boolean> as argument 1: its methods specialize it on <circle>; pass one of those, or define a method on <boolean>
// expect: diagnostic contains no method of `area` accepts function `twice` as argument 1: its methods specialize it on <circle>; pass one of those, or define a method on <function>

// A boolean is a `<boolean>` and a callable a `<function>`, which no method
// here specializes on, so a method on `<boolean>` or `<function>` would take
// one. Both were once accepted here and failed to build.
define class <circle> (<object>)
end;

define generic area(shape);

define method area(c :: <circle>) => <integer>
  1
end;

define function twice(x :: <integer>) => <integer>
  x * 2
end;

define function flag() => <integer>
  area(#t)
end;

define function main() => <integer>
  area(twice)
end;
