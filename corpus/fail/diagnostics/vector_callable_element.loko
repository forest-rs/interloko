// expect: diagnostics 1
// expect: diagnostic code sem.vector-element-type-mismatch
// expect: diagnostic contains vector element 2 expects <object> but got <callable>

// A vector holds `<object>`s, and a callable value is not one, so a closure
// cannot be a vector element.

define function main() => <integer>
  let v = #[1, function (x :: <integer>) => <integer> x end];
  1
end;
