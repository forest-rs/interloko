// expect: diagnostics 1
// expect: diagnostic code sem.unchecked-callable-result
// expect: diagnostic contains cannot be checked to return 2 values (<circle>, <integer>)

// Results needing a runtime check are checked one value at a time, so an
// untyped callable expected to return several values must return ones the
// tape's register types already establish, or declare its signature.

define class <circle> (<object>)
  slot radius :: <integer>;
end;

define class <square> (<object>)
  slot side :: <integer>;
end;

define function first-radius(f :: <callable>) => <integer>
  let (c :: <circle>, n :: <integer>) = apply(f, 3);
  c.radius + n
end;

define function main()
  first-radius(function (x :: <integer>) => (<circle>, <integer>) values(make(<circle>, radius: x), 1) end)
end;
