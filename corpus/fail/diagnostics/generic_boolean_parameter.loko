// expect: diagnostics 1
// expect: diagnostic code ast.annotation-not-class
// expect: diagnostic contains generic parameter `on?` is declared <boolean>, but it must name a class

// Methods specialize a generic's parameters on classes, and `<boolean>` is
// not one, so a generic parameter cannot be declared it, as a method
// parameter cannot.

define generic toggle(on? :: <boolean>) => <integer>;

define function main() => <integer>
  0
end;
