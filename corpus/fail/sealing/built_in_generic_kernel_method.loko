// expect: diagnostic code sem.built-in-method-on-kernel-class
// expect: diagnostic contains a method may join it only for a class of the program's, not <integer>

// The built-in generic `sqrt` is sealed over the kernel's classes, whose
// calls its own overloads serve inline, so a program's method may join it
// only for a class of its own: not even for `<integer>`, which no overload
// takes.

define method sqrt (n :: <integer>) => <double-float>
  as(<double-float>, n)
end;

define function main() => <integer>
  0
end;
