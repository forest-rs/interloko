// expect: diagnostic code sem.collection-default-unsupported
// expect: diagnostics 1
// Methods cannot take keyword parameters yet, so `default:` runs a kernel
// method's defaulting operation, and needs a receiver typing knows has one.

define function lookup(c :: <object>) => <object>
  element(c, 0, default: #f)
end;

define function main() => <object>
  lookup(#[1])
end;
