// expect: diagnostics 1
// expect: diagnostic code sem.local-assignment-type-mismatch
// expect: diagnostic contains local `count` holds <integer> but is assigned <double-float>

// A `let` without a type takes its initializer's, so `count` holds
// `<integer>`s. Declaring it `<real>` would let it hold both.

define function main() => <integer>
  let count = 0;
  count := 1.5;
  count
end;
