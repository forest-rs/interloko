// expect: diagnostics 1
// expect: diagnostic code sem.assigned-local-captured
// expect: diagnostic contains this closure captures `total`, which is assigned

// A closure captures a copy of a local's value when it is made, so a
// capture of an assigned local would read a stale value after the
// assignment. Until captured locals can be shared, capturing one that is
// assigned, before or after the closure is made, is an error.

define function main() => <integer>
  let total = 1;
  let read-total = function () => <integer> total end;
  total := 2;
  read-total()
end;
