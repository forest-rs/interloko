// expect: runtime code runtime.unhandled-condition
// expect: run reports unhandled condition <bad-input>
// expect: diagnostics 0

// A handler for an unrelated class does not apply, so the search runs off
// the end of the dynamic handler stack.

define class <bad-input> (<object>)
  slot fallback :: <integer>;
end;

define class <other-input> (<object>)
  slot fallback :: <integer>;
end;

define function main()
  handle
    signal(make(<bad-input>, fallback: 0))
  with restart e :: <other-input>
    e.fallback
  end
end;
