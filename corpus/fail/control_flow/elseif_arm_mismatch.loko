// expect: diagnostics 1
// expect: diagnostic code sem.if-branch-type-mismatch
// expect: diagnostic contains if branches must produce the same types, not <boolean> and <integer>

// A chain of arms that do not join is reported once, where the first
// pair that does not join meets.

define function main(n :: <integer>)
  if (n < 0) 1 elseif (n = 0) #t else 2 end
end;
