// expect: diagnostics 2
// expect: diagnostic code sem.if-branch-type-mismatch

// An unboxed `<integer>` has no conversion to an abstract `<real>` object,
// so these branches do not join, in either order. Semantic analysis rejects
// the `if` rather than leave lowering a join it cannot build.

define function real-first(c :: <boolean>)
  if (c) as(<real>, 1.5) else 2 end
end;

define function integer-first(c :: <boolean>)
  if (c) 2 else as(<real>, 1.5) end
end;
