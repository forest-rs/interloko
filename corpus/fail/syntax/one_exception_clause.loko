// expect: diagnostics 1
// expect: diagnostic code syntax.expected-token
// expect: diagnostic contains expected `(` or `;` or `end`

// A block takes one exception clause for now. Dylan allows several, each a
// handler established around the body; nesting `block`s is the way to
// handle several classes.

define class <a> (<error>) end;
define class <b> (<error>) end;

define function main() => <integer>
  block ()
    0
  exception (<a>)
    1
  exception (<b>)
    2
  end
end;
